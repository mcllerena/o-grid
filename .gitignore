# Local virtual environment created by uv/venv tools.
.venv/

# Python bytecode cache directories.
__pycache__/

# Pytest run cache.
.pytest_cache/

# Ruff lint/format cache.
.ruff_cache/

# Mypy type checking cache.
.mypy_cache/

# Coverage data file generated by pytest-cov.
.coverage

# HTML coverage report output directory.
htmlcov/

# Package metadata generated during local builds.
*.egg-info/

# Built distribution artifacts.
dist/

# Temporary build directory.
build/

